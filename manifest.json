{
  "manifest_version": 3,
  "name": "Caption Harbor",
  "version": "2.1.9",
  "minimum_chrome_version": "116",
  "description": "Bilingual captions, audio transcription, vocabulary, AI questions, and notes for YouTube, Bilibili, and Apple Podcasts.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.bilibili.com/*",
    "https://bilibili.com/*",
    "https://podcasts.apple.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*",
    "https://api.frdic.com/*"
  ],
  "action": {
    "default_title": "Open Caption Harbor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.bilibili.com/*",
        "https://bilibili.com/*",
        "https://podcasts.apple.com/*"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
