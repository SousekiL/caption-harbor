{
  "name": "caption-harbor",
  "version": "2.1.8",
  "private": true,
  "description": "Bilingual captions, audio transcription, vocabulary, AI questions, and notes for YouTube, Bilibili, and Apple Podcasts.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "bash scripts/check-release.sh",
    "package": "bash scripts/package-extension.sh",
    "test:browser": "playwright test",
    "install:environment": "python3 scripts/install-native-host.py",
    "test:native": "python3 -m unittest discover -s tests/native -p \"test_*.py\"",
    "package:minitool": "python3 scripts/package-minitool.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.8"
  }
}
